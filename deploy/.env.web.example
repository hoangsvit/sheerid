# Copy to /opt/verification-workbench/.env.web and edit before starting the service.
# Instabox public port entry: 0.0.0.0; local Nginx proxy: 127.0.0.1.
WORKBENCH_WEB_HOST=127.0.0.1
# Replace with your own HTTPS origin, without a path or trailing slash.
WORKBENCH_WEB_PUBLIC_ORIGIN=https://workbench.example.com
